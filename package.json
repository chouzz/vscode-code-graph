{
  "name": "symbol-hierarchy-viewer",
  "displayName": "Symbol Hierarchy Viewer",
  "description": "Displays call hierarchy or find references in a webview panel.",
  "version": "0.0.1",
  "publisher": "jules-ai",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:symbol-hierarchy-viewer.showCallHierarchy",
    "onCommand:symbol-hierarchy-viewer.findReferences",
    "onView:symbolHierarchyView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "symbol-hierarchy-viewer.showCallHierarchy",
        "title": "Show Call Hierarchy in Panel"
      },
      {
        "command": "symbol-hierarchy-viewer.findReferences",
        "title": "Find References in Panel"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "symbolHierarchyContainer",
          "title": "Symbol Hierarchy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "symbolHierarchyContainer": [
        {
          "id": "symbolHierarchyView",
          "name": "Hierarchy Results",
          "type": "webview",
          "contextualTitle": "Symbol Hierarchy"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "glob": "^8.1.0",
    "typescript": "^5.3.3"
  }
}
